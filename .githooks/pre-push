#!/bin/sh
# Refuse a push that carries a commit whose author or committer is not an identity this repository publishes under.
# pre-commit refuses such a commit when it is made; a cherry-pick or --no-verify goes past it, and the CI reports only
# once the commit is on origin, where removing it needs a force push (from Retainer-Repricer, passed on in
# KerbalMissionDirector #5, 14.11.2026). check_commit_identity.py tests this hook with a real push.
. "$(dirname "$0")/python.sh"
if [ -z "$PYTHON" ]; then
	echo "pre-push: no working Python found - commit identities not checked here; the CI checks them" >&2
	exit 0
fi
# Both read git's lines on stdin; it is read once and handed to each.
input="$(cat)"
printf '%s\n' "$input" | $PYTHON "$(dirname "$0")/../.github/scripts/audit/check_commit_identity.py" --pre-push || exit 1
# The CI's checks and build here, before the push (A895, pre_push_gate.py): on GitHub the CI runs only when a pull
# request opens or is marked ready, and on request.
printf '%s\n' "$input" | $PYTHON "$(dirname "$0")/../.github/scripts/audit/pre_push_gate.py"
