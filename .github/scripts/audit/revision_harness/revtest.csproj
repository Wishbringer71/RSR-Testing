<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>revtest</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0414;CS0169;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json"><HintPath>$(HOME)/.xlcore/dalamud/Hooks/dev/Newtonsoft.Json.dll</HintPath></Reference>
    <Using Include="Newtonsoft.Json" />
    <Using Include="RotationSolver.Basic.Helpers" />
  </ItemGroup>
</Project>
